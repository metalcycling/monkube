# Deserialization is the dominant CPU cost when parsing large kubectl JSON
# payloads, so prefer 'orjson' (consumes bytes directly, ~2-4x faster than the
# standard library) and fall back to 'json' when it is not installed.
try:
    import orjson
    _json_loads = orjson.loads

except ImportError:
    import json

    def _json_loads(data):
        return json.loads(data)

# %% Kubectl invocation

# Every kubectl command in this script is built from this prefix, so pointing the whole
# run at a different cluster is a matter of rewriting it once (see '--context' below)
# instead of threading the flag through each call site
KUBECTL = "kubectl"

# %% ANSI color codes

BOLD    = "\033[1m"
DIM     = "\033[2m"
RED     = "\033[31m"
GREEN   = "\033[32m"
YELLOW  = "\033[33m"
BLUE    = "\033[34m"
MAGENTA = "\033[35m"
CYAN    = "\033[36m"
WHITE   = "\033[37m"
RESET   = "\033[0m"

def colorize_percentage(value):
    """
    Return a color code based on utilization percentage thresholds
    """
    if value < 50.0:
        return GREEN

    elif value < 80.0:
        return YELLOW

    else:
        return RED

# %% Timing variables

times = {}
times["etcd"] = 0.0
times["parsing"] = time.time()

# %% Functions

def bash(command, print_stdout = True, print_stderr = True, as_bytes = False):
    """
    - Run bash commands as if they are directly typed on the shell and return response
    - Print 'stdout' if 'print_stdout = True' and 'stderr' if 'print_stderr = True'
    - If 'as_bytes = True', return the raw 'stdout' bytes (intended to be fed straight
      into a JSON parser); otherwise return a list of decoded 'stdout' lines followed
      by the decoded 'stderr' lines
    """
    proc = subprocess.Popen(command, shell = True, stdout = subprocess.PIPE, stderr = subprocess.PIPE)
    stdout_bytes, stderr_bytes = proc.communicate()

    if as_bytes:
        if print_stdout and stdout_bytes:
            print(stdout_bytes.decode("utf-8"), end = "")

        if print_stderr and stderr_bytes:
            print(stderr_bytes.decode("utf-8"), end = "")

        return stdout_bytes

    # Splitting on '\n' and dropping a single trailing empty element reproduces the
    # previous per-line 'readlines()' behavior exactly (no trailing-newline ghost line)
    stdout_response = stdout_bytes.decode("utf-8").split("\n")
    if stdout_response and stdout_response[-1] == "":
        stdout_response.pop()

    stderr_response = stderr_bytes.decode("utf-8").split("\n")
    if stderr_response and stderr_response[-1] == "":
        stderr_response.pop()

    if print_stdout:
        for line in stdout_response:
            print(line)

    if print_stderr:
        for line in stderr_response:
            print(line)

    return stdout_response + stderr_response

def get_memory_from_string(string):
    """
    Parse string with memory information. Returns the value in Gi.
    """
    if string.isdigit():
        return float(string) / (1024 ** 3)

    elif string[-2:] == "Ki":
        return float(string[:-2]) / (1024 ** 2)

    elif string[-1:] == "K":
        return float(string[:-1]) / (1024 ** 2)

    elif string[-2:] == "Mi":
        return float(string[:-2]) / (1024 ** 1)

    elif string[-1:] == "M":
        return float(string[:-1]) / (1024 ** 1)

    elif string[-2:] == "Gi":
        return float(string[:-2]) / (1024 ** 0)

    elif string[-1:] == "G":
        return float(string[:-1]) / (1024 ** 0)

    elif string[-2:] == "Ti":
        return float(string[:-2]) / (1024 ** -1)

    elif string[-1:] == "T":
        return float(string[:-1]) / (1024 ** -1)

def get_cpu_from_string(string):
    """
    Parse string with cpu information. Returns the value in millicores.
    """
    if isinstance(string, int):
        return float(string)

    else:
        if string[-1] == "m":
            return float(string[:-1])

        elif string.isnumeric():
            return float(string) * 1000.0

        else:
            print("%sCPU value '%s' is not understood%s" % (RED, string, RESET))
            quit()

def get_gpu_from_string(string):
    """
    Parse string with gpu information. Returns the value in number of fractional GPUs.
    """
    return float(string)

GPU_RESOURCE_KEYS = ("nvidia.com/gpu", "amd.com/gpu")

def node_is_gpu(node):
    """
    Classify a node as a GPU node by the *presence* of a GPU resource key in its
    capacity or allocatable, independent of the advertised count. A GPU node whose
    device plugin is momentarily advertising zero healthy GPUs (e.g. SageMaker
    HyperPod health-cycling, a drain, or a device-plugin restart) still carries the
    'nvidia.com/gpu' key with value 0; keying off the count instead would misclassify
    such a node as CPU-only (the trap '-co' fell into in 'full' mode).
    """
    status = node.get("status", {})

    for field in ("capacity", "allocatable"):
        resources = status.get(field, {})

        if any(key in resources for key in GPU_RESOURCE_KEYS):
            return True

    return False

def get_gpu_capacity_deficit(node):
    """
    Number of GPUs the node physically reports but that cannot be scheduled onto.

    Kubelet advertises device-plugin resources with capacity = every device the plugin
    reported and allocatable = only those it currently considers healthy, so a nonzero
    difference is the count of GPUs the plugin has taken out of service (e.g. after a
    critical Xid). Percentages below are denominated at allocatable -- the honest ceiling
    for scheduling -- which on its own leaves a node with dead GPUs indistinguishable
    from a smaller idle node, so the deficit is reported right next to it.
    """
    status = node.get("status", {})
    capacity = status.get("capacity", {})
    allocatable = status.get("allocatable", {})

    for key in GPU_RESOURCE_KEYS:
        if key in capacity and key in allocatable:
            return get_gpu_from_string(capacity[key]) - get_gpu_from_string(allocatable[key])

    return 0.0

BLOCKING_TAINT_EFFECTS = ("NoSchedule", "NoExecute")

def get_node_status_markers(node):
    """
    Reasons a node cannot accept a new pod, as a list of '(text, color)' pairs.

    Allocation percentages alone cannot answer 'is this node available?': a cordoned,
    tainted or NotReady node reports idle cpu/gpu/mem that nothing can actually land on,
    so without these markers it reads as free capacity.
    """
    spec = node.get("spec", {})
    status = node.get("status", {})
    markers = []

    ready = None

    for condition in status.get("conditions", []):
        if condition.get("type") == "Ready":
            ready = condition.get("status")

    if ready == "False":
        markers.append(("NotReady", RED))

    elif ready != "True":
        markers.append(("Ready=Unknown", RED))

    if spec.get("unschedulable"):
        markers.append(("cordoned", RED))

    for taint in spec.get("taints") or []:
        effect = taint.get("effect", "")

        if effect not in BLOCKING_TAINT_EFFECTS:
            continue

        key = taint.get("key", "")

        # 'kubectl cordon' sets both 'spec.unschedulable' and this taint, so reporting
        # the taint as well would state the same thing twice
        if key == "node.kubernetes.io/unschedulable":
            continue

        value = taint.get("value")
        markers.append(("%s%s:%s" % (key, "=" + value if value else "", effect), YELLOW))

    return markers

def format_status_markers(markers):
    """
    Render '(text, color)' status markers as a bracketed, colorized string
    """
    return " ".join(["%s[%s]%s" % (color, text, RESET) for text, color in markers])

def format_gpu_deficit(deficit):
    """
    Render an unhealthy-GPU count as a suffix for the 'gpu' allocation line
    """
    return "  %s[%g unhealthy]%s" % (RED, deficit, RESET) if deficit > 0.0 else ""

def node_needs_attention(node):
    """
    Whether a node is worth looking at: it cannot accept new pods (cordoned, tainted,
    NotReady) or its device plugin has withdrawn GPUs the node still reports as capacity
    """
    return bool(get_node_status_markers(node)) or get_gpu_capacity_deficit(node) > 0.0

STATUS_COLORS = {
    "Running":            GREEN,
    "Succeeded":          GREEN,
    "Completed":          GREEN,
    "Active":             GREEN,
    "Bound":              GREEN,
    "Pending":            YELLOW,
    "ContainerCreating":  YELLOW,
    "Terminating":        YELLOW,
    "Failed":             RED,
    "CrashLoopBackOff":   RED,
    "Error":              RED,
    "ImagePullBackOff":   RED,
    "ErrImagePull":       RED,
    "OOMKilled":          RED,
    "Evicted":            RED,
}

def colorize_columns(lines):
    """
    Apply per-column colors to tabular kubectl output
    """
    if not lines or not lines[0]:
        return lines

    header = lines[0]
    col_starts = []

    if not header[0].isspace():
        col_starts.append(0)

    for i in range(1, len(header)):
        if header[i] != ' ' and header[i - 1] == ' ':
            col_starts.append(i)

    if not col_starts:
        return lines

    col_names = []

    for c_idx, start in enumerate(col_starts):
        end = col_starts[c_idx + 1] if c_idx + 1 < len(col_starts) else len(header)
        col_names.append(header[start:end].strip())

    status_col = col_names.index("STATUS") if "STATUS" in col_names else -1

    colored_lines = [BOLD + header + RESET]

    for line in lines[1:]:
        colored_line = ""

        for c_idx, start in enumerate(col_starts):
            if start >= len(line):
                break

            end = col_starts[c_idx + 1] if c_idx + 1 < len(col_starts) else len(line)
            value = line[start:end]

            if c_idx == status_col:
                color = STATUS_COLORS.get(value.strip(), WHITE)
            else:
                color = WHITE if c_idx % 2 == 0 else CYAN

            colored_line += color + value

        colored_line += RESET
        colored_lines.append(colored_line)

    return colored_lines

def get_dashed_header(header_string, num_header_characters = 80):
    """
    Returns a centered string with dashes on both sides separated by spaces
    """
    if header_string == None:
        output_string = DIM + "-" * num_header_characters + RESET

    elif len(header_string) > num_header_characters:
        output_string = BOLD + CYAN + header_string[:num_header_characters] + RESET

    else:
        num_dashes = num_header_characters - (len(header_string) + 2)
        num_left_dashes = math.ceil(num_dashes / 2)
        num_right_dashes = num_dashes - num_left_dashes
        output_string = "%s%s%s %s%s%s %s%s%s\n" % (DIM, "-" * num_left_dashes, RESET, BOLD + CYAN, header_string, RESET, DIM, "-" * num_right_dashes, RESET)

    return output_string

def fetch_pods_raw(executor):
    """
    Fetch every pod in the cluster, issuing one concurrent 'kubectl get pods' per
    namespace. Splitting the single '--all-namespaces' request into parallel
    per-namespace requests is dramatically faster because the apiserver/proxy is
    bound by per-stream throughput rather than aggregate bandwidth. Returns a list
    of raw JSON byte payloads (one per namespace) to be parsed by the caller.
    """
    namespaces_raw = bash("%s get namespaces -o json" % (KUBECTL), print_stdout = False, print_stderr = False, as_bytes = True)
    namespaces = [item["metadata"]["name"] for item in _json_loads(namespaces_raw)["items"]]

    futures = [executor.submit(bash, "%s get pods -n %s -o json" % (KUBECTL, namespace), False, False, True) for namespace in namespaces]

    return [future.result() for future in futures]

# %% Main function

def main(args, executor):
    """
    Main program to monitor resources
    """

    # %% Get resources from etcd

    if args.resources:
        # Phase 1: build every (resource, namespace) query and fire them concurrently
        t_start = time.time()
        futures = {}

        for r_idx, resource in enumerate(args.resources):
            for n_idx, namespace in enumerate(args.namespaces):
                command = "%s -n %s get %s" % (KUBECTL, namespace, resource)

                if args.sort:
                    command += " --sort-by=.metadata.creationTimestamp"

                if args.labels:
                    command += " --selector='"

                    for idx, label in enumerate(args.labels):
                        key, value = label.split("=")

                        command += "%s in (%s)" % (key, ", ".join(value.split("|")))

                        if idx < len(args.labels) - 1:
                            command += ", "

                    command += "'"

                if args.status and "pod" in resource:
                    command += " --field-selector=status.phase==%s" % (args.status)

                futures[(r_idx, n_idx)] = executor.submit(bash, command, False, False)

        responses = {key: future.result() for key, future in futures.items()}
        t_end = time.time()
        times["etcd"] += t_end - t_start

        # Phase 2: render in the original (resource-major, namespace-minor) order
        for r_idx, resource in enumerate(args.resources):
            print(get_dashed_header(resource.upper() + ":"))

            for n_idx, namespace in enumerate(args.namespaces):
                response = responses[(r_idx, n_idx)]

                print("%s%sNAMESPACE: '%s'%s" % (BOLD, BLUE, namespace, RESET))

                if len(response) > 1 and args.sort:
                    response = [response[0]] + response[1:][::-1][:args.num_lines]
                elif args.num_lines:
                    response = response[:args.num_lines + 1]

                print("\n".join(colorize_columns(response)))
                print()

    # %% Get nodes

    if args.nodes:
        # Fetch the node list and (only in full mode) every pod concurrently. The
        # per-namespace pod fan-out inside fetch_pods_raw() runs in the same pool and
        # overlaps with the nodes fetch, so the wall-clock cost is roughly the single
        # slowest request rather than the sum of them all
        t_start = time.time()

        nodes_future = executor.submit(bash, "%s get nodes -o json" % (KUBECTL), False, False, True)
        pod_raws = fetch_pods_raw(executor) if args.nodes == "full" else None
        nodes_raw = nodes_future.result()

        t_end = time.time()
        times["etcd"] += t_end - t_start

        nodes = _json_loads(nodes_raw)["items"]

        # Parse each creation timestamp once and reuse it for both the sort key and the
        # age column. 'fromisoformat(...).replace(tzinfo=None)' produces the same naive
        # value as the previous strptime call but is markedly faster
        creation_dts = [datetime.fromisoformat(node["metadata"]["creationTimestamp"]).replace(tzinfo = None) for node in nodes]

        if args.sort:
            nodes_idx = sorted(range(len(nodes)), key = lambda i: creation_dts[i])[::-1]
        else:
            nodes_idx = range(len(nodes))

        if args.target_nodes:
            target_set = set(args.target_nodes)
            nodes_idx = [idx for idx in nodes_idx if nodes[idx]["metadata"]["name"] in target_set]

        stdout = []

        if args.nodes == "reduced":
            num_nodes = 0
            name_width = max([len(nodes[idx]["metadata"]["name"]) for idx in nodes_idx], default = len("NAME"))
            age_width = len("%3d:%02d:%02d" % (0, 0, 0))

            stdout.append("%s%s%-*s  %-*s  %s%s" % (BOLD, CYAN, name_width, "NAME", age_width, "AGE", "STATUS", RESET))

            for idx in nodes_idx:
                node = nodes[idx]

                if args.gpu_only and not node_is_gpu(node):
                    continue

                if args.cpu_only and node_is_gpu(node):
                    continue

                if args.unhealthy_only and not node_needs_attention(node):
                    continue

                name = node["metadata"]["name"]
                creation_timestamp = creation_dts[idx]
                lapsed_seconds = int(abs((creation_timestamp - datetime.now(timezone.utc).replace(tzinfo=None)).total_seconds()))
                age_hours = lapsed_seconds // 3600
                age_minutes = (lapsed_seconds % 3600) // 60
                age_seconds = (lapsed_seconds % 3600) % 60
                age = "%3d:%02d:%02d" % (age_hours, age_minutes, age_seconds)

                markers = get_node_status_markers(node)
                gpu_deficit = get_gpu_capacity_deficit(node)

                if gpu_deficit > 0.0:
                    markers.append(("%g GPUs unhealthy" % (gpu_deficit), RED))

                status = format_status_markers(markers)

                stdout.append("")
                stdout[-1] += "%-*s  %-*s%s" % (name_width, name, age_width, age, "  " + status if status else "")
                num_nodes += 1

                if args.num_nodes:
                    if num_nodes == int(args.num_nodes):
                        break

            stdout.append("")

        else:
            pods = []

            for raw in pod_raws:
                try:
                    pods.extend(_json_loads(raw)["items"])
                except Exception:
                    pass

            for node in nodes:
                capacity = node["status"]["allocatable"]
                node["utilization"] = { "avail": {}, "alloc": {} }

                node["utilization"]["avail"]["cpu"] = get_cpu_from_string(capacity["cpu"]) if "cpu" in capacity else 0.0
                node["utilization"]["avail"]["mem"] = get_memory_from_string(capacity["memory"]) if "memory" in capacity else 0.0

                if "nvidia.com/gpu" in capacity:
                    node["utilization"]["avail"]["gpu"] = get_gpu_from_string(capacity["nvidia.com/gpu"])
                elif "amd.com/gpu" in capacity:
                    node["utilization"]["avail"]["gpu"] = get_gpu_from_string(capacity["amd.com/gpu"])
                else:
                    node["utilization"]["avail"]["gpu"] = 0.0

                node["utilization"]["alloc"]["cpu"] = 0.0
                node["utilization"]["alloc"]["gpu"] = 0.0
                node["utilization"]["alloc"]["mem"] = 0.0

            name_to_node = {}

            for idx, node in enumerate(nodes):
                name_to_node[node["metadata"]["name"]] = idx

            for pod in pods:
                cpu_total = 0.0
                gpu_total = 0.0
                mem_total = 0.0

                for container in pod["spec"]["containers"]:
                    request = container["resources"]["requests"] if "requests" in container["resources"] else {}

                    cpu_total += get_cpu_from_string(request["cpu"]) if "cpu" in request else 0.0
                    mem_total += get_memory_from_string(request["memory"]) if "memory" in request else 0.0

                    if "nvidia.com/gpu" in request:
                        gpu_total += get_gpu_from_string(request["nvidia.com/gpu"])
                    elif "amd.com/gpu" in request:
                        gpu_total += get_gpu_from_string(request["amd.com/gpu"])
                    else:
                        gpu_total += 0.0

                if "phase" in pod["status"] and pod["status"]["phase"] in ["Running", "Pending"]:
                    if "nodeName" not in pod["spec"]:
                        continue

                    node_name = pod["spec"]["nodeName"]

                    if node_name in name_to_node:
                        idx = name_to_node[node_name]
                        nodes[idx]["utilization"]["alloc"]["cpu"] += cpu_total
                        nodes[idx]["utilization"]["alloc"]["gpu"] += gpu_total
                        nodes[idx]["utilization"]["alloc"]["mem"] += mem_total

            num_nodes = 0

            for idx in nodes_idx:
                node = nodes[idx]

                if args.gpu_only and not node_is_gpu(node):
                    continue

                if args.cpu_only and node_is_gpu(node):
                    continue

                if args.unhealthy_only and not node_needs_attention(node):
                    continue

                name = node["metadata"]["name"]

                cpu_avail = node["utilization"]["avail"]["cpu"]
                gpu_avail = node["utilization"]["avail"]["gpu"]
                mem_avail = node["utilization"]["avail"]["mem"]

                cpu_alloc = node["utilization"]["alloc"]["cpu"]
                gpu_alloc = node["utilization"]["alloc"]["gpu"]
                mem_alloc = node["utilization"]["alloc"]["mem"]

                cpu_percent = cpu_alloc / cpu_avail * 100.0 if cpu_avail > 0.0 else 0.0
                gpu_percent = gpu_alloc / gpu_avail * 100.0 if gpu_avail > 0.0 else 0.0
                mem_percent = mem_alloc / mem_avail * 100.0 if mem_avail > 0.0 else 0.0

                status = format_status_markers(get_node_status_markers(node))
                gpu_note = format_gpu_deficit(get_gpu_capacity_deficit(node))

                stdout.append("")
                stdout[-1] += "%s%sNAME: %s%s%s\n" % (BOLD, WHITE, name, RESET, "  " + status if status else "")
                stdout[-1] += "    %scpu%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)\n" % (WHITE, RESET, BLUE, cpu_alloc, RESET, DIM, RESET, BLUE, cpu_avail, RESET, colorize_percentage(cpu_percent), cpu_percent, RESET)
                stdout[-1] += "    %sgpu%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)%s\n" % (WHITE, RESET, BLUE, gpu_alloc, RESET, DIM, RESET, BLUE, gpu_avail, RESET, colorize_percentage(gpu_percent), gpu_percent, RESET, gpu_note)
                stdout[-1] += "    %smem%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)\n" % (WHITE, RESET, BLUE, mem_alloc, RESET, DIM, RESET, BLUE, mem_avail, RESET, colorize_percentage(mem_percent), mem_percent, RESET)
                num_nodes += 1

                if args.num_nodes:
                    if num_nodes == int(args.num_nodes):
                        break

        print(get_dashed_header("CLUSTER NODES:"))
        print("\n".join(stdout))

    if args.target_nodes and not args.nodes:
        t_start = time.time()
        selector = "kubernetes.io/hostname in (%s)" % (", ".join(args.target_nodes))
        nodes_future = executor.submit(bash, "%s get nodes -o json --selector='%s'" % (KUBECTL, selector), False, False, True)
        response = bash("%s describe nodes --selector='%s'" % (KUBECTL, selector), print_stdout = False, print_stderr = False)

        node_markers = {}
        node_gpu_deficits = {}

        try:
            for node in _json_loads(nodes_future.result())["items"]:
                node_markers[node["metadata"]["name"]] = get_node_status_markers(node)
                node_gpu_deficits[node["metadata"]["name"]] = get_gpu_capacity_deficit(node)
        except Exception:
            pass

        t_end = time.time()
        times["etcd"] += t_end - t_start

        stdout = []

        cpu_avail, cpu_alloc = None, None
        gpu_avail, gpu_alloc = None, None
        mem_avail, mem_alloc = None, None

        node_id = 0

        for idx, line in enumerate(response):
            if "Name:" in line:
                name = line.split()[-1]

            if "Allocatable:" in line:
                jdx = 1

                while response[idx + jdx][:2] == "  ":
                    if "cpu" in response[idx + jdx]:
                        cpu_avail = get_cpu_from_string(response[idx + jdx].split()[1])

                    if "memory" in response[idx + jdx]:
                        mem_avail = get_memory_from_string(response[idx + jdx].split()[1])

                    if "nvidia.com/gpu" in response[idx + jdx]:
                        gpu_avail = get_gpu_from_string(response[idx + jdx].split()[1])

                    if "amd.com/gpu" in response[idx + jdx]:
                        gpu_avail = get_gpu_from_string(response[idx + jdx].split()[1])

                    jdx += 1

            if "Allocated resources:" in line:
                jdx = 1

                while response[idx + jdx][:2] == "  ":
                    if "cpu" in response[idx + jdx]:
                        cpu_alloc = get_cpu_from_string(response[idx + jdx].split()[1])

                    if "memory" in response[idx + jdx]:
                        mem_alloc = get_memory_from_string(response[idx + jdx].split()[1])

                    if "nvidia.com/gpu" in response[idx + jdx]:
                        gpu_alloc = get_gpu_from_string(response[idx + jdx].split()[1])

                    if "amd.com/gpu" in response[idx + jdx]:
                        gpu_alloc = get_gpu_from_string(response[idx + jdx].split()[1])

                    jdx += 1

            if cpu_avail and cpu_alloc and mem_avail and mem_alloc:
                gpu_avail = gpu_avail if gpu_avail else 0.0
                gpu_alloc = gpu_alloc if gpu_alloc else 0.0

                cpu_percent = cpu_alloc / cpu_avail * 100.0 if cpu_avail > 0.0 else 0.0
                gpu_percent = gpu_alloc / gpu_avail * 100.0 if gpu_avail > 0.0 else 0.0
                mem_percent = mem_alloc / mem_avail * 100.0 if mem_avail > 0.0 else 0.0

                status = format_status_markers(node_markers.get(name, []))
                gpu_note = format_gpu_deficit(node_gpu_deficits.get(name, 0.0))

                stdout.append("")
                stdout[-1] += "%s%sNAME: %s%s%s\n" % (BOLD, WHITE, name, RESET, "  " + status if status else "")

                stdout[-1] += "    %scpu%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)\n" % (WHITE, RESET, BLUE, cpu_alloc, RESET, DIM, RESET, BLUE, cpu_avail, RESET, colorize_percentage(cpu_percent), cpu_percent, RESET)
                stdout[-1] += "    %sgpu%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)%s\n" % (WHITE, RESET, BLUE, gpu_alloc, RESET, DIM, RESET, BLUE, gpu_avail, RESET, colorize_percentage(gpu_percent), gpu_percent, RESET, gpu_note)
                stdout[-1] += "    %smem%s: %s%9.2f%s %s/%s %s%9.2f%s (%s%6.2f%%%s)\n" % (WHITE, RESET, BLUE, mem_alloc, RESET, DIM, RESET, BLUE, mem_avail, RESET, colorize_percentage(mem_percent), mem_percent, RESET)

                node_id += 1

                cpu_avail, cpu_alloc = None, None
                gpu_avail, gpu_alloc = None, None
                mem_avail, mem_alloc = None, None

        print(get_dashed_header("CLUSTER NODES:"))
        print("\n".join(stdout))

    print(get_dashed_header(None))

    times["parsing"] = (time.time() - times["parsing"]) - times["etcd"]

    print()
    print("%s   ETCD time: %0.2f s%s" % (DIM, times["etcd"], RESET))
    print("%sParsing time: %0.2f s%s" % (DIM, times["parsing"], RESET))
    print()

# %% Main program

if __name__ == "__main__":
    """
    Monkube: This utility monitors a list of Kubernetes resources for a list of specified namespaces
    """

    parser = argparse.ArgumentParser(prog = "Monkube", description = "Monitoring of kubernetes resources")
    parser.add_argument("-r", "--resources", default = None, help = "Comma-separated list of resources to be monitored")
    parser.add_argument("-n", "--namespaces", default = "", help = "Comma-separated list of namespaces to be monitored")
    parser.add_argument("-l", "--num_lines", default = None, type = int, help = "Number of lines to print for each resource")
    parser.add_argument("-s", "--sort", action = "store_true", help = "Sort resources starting with the most recently used")
    parser.add_argument("-t", "--labels", default = None, help = "Get subset of resources matching the specified comma-separated list of labels. Use '|' to specify multiple matches for a given key. EXAMPLE: \"--labels key-1=value-1,key-2='value-2|value-3'\"")
    parser.add_argument("-nd", "--nodes", default = None, choices = ["full", "reduced"], help = "Show allocation and utilization of nodes")
    parser.add_argument("-ln", "--num_nodes", default = None, help = "Show data for the first 'num_nodes'")
    parser.add_argument("-tn", "--target_nodes", default = None, help = "Comma-separated list of specific nodes to query. When combined with '-nd', filters the node output to just these nodes")
    parser.add_argument("-st", "--status", default = None, help = "Get pods matching 'status'")
    parser.add_argument("-go", "--gpu_only", action = "store_true", help = "Only show nodes with GPUs (use with -nd)")
    parser.add_argument("-co", "--cpu_only", action = "store_true", help = "Only show nodes without GPUs (use with -nd)")
    parser.add_argument("-uo", "--unhealthy_only", action = "store_true", help = "Only show nodes that cannot take new pods (cordoned, tainted, NotReady) or that report unhealthy GPUs (use with -nd)")
    parser.add_argument("-c", "--context", default = None, help = "Kubeconfig context to query; defaults to the current context")
    parser.add_argument("-j", "--jobs", default = 16, type = int, help = "Number of concurrent kubectl workers")

    args = parser.parse_args()

    # Resolve the target cluster first: every later query is built from 'KUBECTL'. An
    # unknown context is rejected up front because most calls suppress stderr, so kubectl's
    # own complaint would otherwise be swallowed and reported as an empty cluster
    if args.context:
        contexts = bash("kubectl config get-contexts -o name", print_stdout = False, print_stderr = False)

        if args.context not in contexts:
            available = "\n".join("  " + name for name in contexts) if contexts else "  (none)"
            parser.error("context '%s' not found in kubeconfig. Available contexts:\n%s" % (args.context, available))

        KUBECTL = "kubectl --context=%s" % (shlex.quote(args.context))

    args.resources = args.resources.split(",") if args.resources else None
    args.labels = args.labels.split(",") if args.labels else None
    args.target_nodes = args.target_nodes.split(",") if args.target_nodes else None

    # The current-context namespace is only needed as the default when '-n' is absent,
    # so look it up lazily instead of paying for two kubectl calls on every invocation
    if args.namespaces:
        args.namespaces = args.namespaces.split(",")
    else:
        t_start = time.time()

        # 'get-contexts' only prints the leading '*' column for the current context, so
        # the namespace lands in a different field for any other one. Reading it out of
        # the kubeconfig instead is column-independent and works for both cases
        response = bash("%s config view --minify --output 'jsonpath={..namespace}'" % (KUBECTL), print_stdout = False)
        current_namespace = response[0].strip() if response else ""

        t_end = time.time()
        times["etcd"] += t_end - t_start

        if current_namespace == "":
            current_namespace = "default"

        args.namespaces = [current_namespace]

    if args.resources is None and args.nodes is None and args.target_nodes is None:
        parser.print_help()
    else:
        with ThreadPoolExecutor(max_workers = args.jobs) as executor:
            main(args, executor)

# %% End of program
